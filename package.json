{
  "name": "@raghav-56/flexoki-mcp-server",
  "version": "1.2.0",
  "description": "MCP server for generating and integrating Flexoki theme setup across web projects.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "flexoki-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/**/*.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "flexoki",
    "theme",
    "tailwind"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
